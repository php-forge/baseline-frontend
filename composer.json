{
    "name": "php-forge/baseline-frontend",
    "type": "library",
    "description": "Frontend baseline for Prettier and stylelint tooling shared via yii2-extensions/scaffold.",
    "keywords": [
        "baseline",
        "frontend",
        "prettier",
        "stylelint",
        "css",
        "scss",
        "linters",
        "php-forge",
        "scaffold-provider"
    ],
    "license": "BSD-3-Clause",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3"
    },
    "autoload": {
        "psr-4": {
            "PHPForge\\BaselineFrontend\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "scaffold": {
            "manifest": "scaffold.json"
        }
    },
    "config": {
        "sort-packages": true
    }
}
